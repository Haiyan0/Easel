# Task 8 worker 镜像。
#
# 构建链：dsh-build（固定 Harness 源码/Linux 构建）与
# base（最小生命周期）→ chromium（真实浏览器）→ execution（worker 代码）
# → runtime（真实 Harness 最终镜像）。未指定 --target 时构建最终 runtime；
# 缺少固定的 Harness commit 或经验证的 ACP profile 会构建失败，绝不产出
# “看起来能跑”的未固定镜像。
#
#   docker build -f deploy/multiuser/Dockerfile.worker \
#     --build-arg DSH_COMMIT=<已验收 commit> -t easel-worker:<tag> .
#
# 隔离集成测试只需生命周期入口，可显式构建 base：
#   docker build -f deploy/multiuser/Dockerfile.worker --target base \
#     -t easel-worker-test:base .

ARG PYTHON_VERSION=3.11.12
# Node 24.22.1 满足 Harness engines（^22.19.0 || >=24.0.0）。镜像按 digest
# 固定；pnpm 也在构建期按精确版本激活，运行阶段不再安装 npm/pnpm。
ARG NODE_IMAGE=node@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
ARG PNPM_VERSION=11.28.5
FROM ${NODE_IMAGE} AS dsh-build

ARG DSH_REPOSITORY=https://github.com/deepseek-ai/deepseek-harness.git
ARG DSH_COMMIT=""
ARG PNPM_VERSION=11.28.5

ENV CI=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN printf 'Acquire::Retries "5";\n' > /etc/apt/apt.conf.d/80-retries \
 && test -n "${DSH_COMMIT}" \
      || { echo "DSH_COMMIT 必须固定为已验收的 Harness commit" >&2; exit 1; } \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git build-essential python3 \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable \
 && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
 && test "$(pnpm --version)" = "${PNPM_VERSION}"

# 从公开仓库取固定 commit；不使用宿主 node_modules 或未固定 tarball。
# GitHub 若拒绝按 SHA 取，可回退到该版本 tag；随后仍强制核对完整 SHA。
RUN git init /opt/dsh \
 && git -C /opt/dsh remote add origin "${DSH_REPOSITORY}" \
 && (git -C /opt/dsh fetch --depth 1 origin "${DSH_COMMIT}" \
     || git -C /opt/dsh fetch --depth 1 origin \
          refs/tags/dsh-v0.2.1-rc.2) \
 && git -C /opt/dsh checkout --detach FETCH_HEAD \
 && test "$(git -C /opt/dsh rev-parse HEAD)" = "${DSH_COMMIT}"

WORKDIR /opt/dsh
# 完整构建依赖 frozen 安装；不能只 prod install、也不能无锁 npm install。
RUN pnpm install --frozen-lockfile

# 实际执行 Linux 原生组件与 Host/CLI 构建。tsdown 为所有 workspace 包
# 生成运行产物（含 apps/cli/lib/bin.js），不是只把源码放进镜像。
RUN pnpm run build:native-system \
 && node --max-old-space-size=4096 \
      ./node_modules/typescript/bin/tsc -b tsconfig.host.json \
 && pnpm exec tsdown --config-loader native --env.DSH_BUILD_FACE host \
 && test -f apps/cli/lib/bin.js \
 && test -f apps/cli/lib/profile-boot.js \
 && node apps/cli/lib/bin.js --help >/dev/null

# DSH 的 Linux 沙箱链是 bwrap → landlock：基础镜像没有 bwrap，必须自带
# static-musl 的 landlock-run 启动器，否则所有 bash 调用都会 fail closed
# （"no sandbox backend is usable"）。build:native-system 的
# --host-addon-only 只构建 flock 插件并跳过启动器，这里补一次完整构建。
RUN apt-get update \
 && apt-get install -y --no-install-recommends musl-tools \
 && rm -rf /var/lib/apt/lists/* \
 && pnpm exec tsx native/system/scripts/build.ts \
 && launcher="$(find native/system/packages -path '*/bin/landlock-run' \
      -type f -print -quit)" \
 && test -n "${launcher}" && test -x "${launcher}"

# 构建输入与产物摘要进入构建日志，便于复现核对（不含任何凭证）。
RUN sha256sum pnpm-lock.yaml apps/cli/lib/bin.js

FROM python:${PYTHON_VERSION}-slim-bookworm AS base

ARG FASTAPI_VERSION=0.115.6
ARG UVICORN_VERSION=0.32.1
ARG HTTPX_VERSION=0.28.1
ARG PYDANTIC_VERSION=2.10.4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    EASEL_SERVICE_MODE=worker \
    EASEL_CODE_ROOT=/opt/easel \
    EASEL_WORKSPACE_ROOT=/workspace \
    EASEL_STATE_ROOT=/workspace/state \
    HOME=/home/easel

# uid/gid 10001 固定；provisioner 在宿主把持久目录 chown 给该 uid。
RUN groupadd --gid 10001 easel \
 && useradd --uid 10001 --gid 10001 --home-dir /home/easel \
            --create-home --shell /usr/sbin/nologin easel \
 && mkdir -p /opt/easel /workspace \
 && chown easel:easel /workspace

WORKDIR /opt/easel
COPY pyproject.toml README.md ./
COPY easel ./easel
RUN pip install --no-cache-dir \
      "fastapi==${FASTAPI_VERSION}" \
      "uvicorn==${UVICORN_VERSION}" \
      "httpx==${HTTPX_VERSION}" \
      "pydantic==${PYDANTIC_VERSION}" \
 && chown -R root:root /opt/easel \
 && chmod -R a-w /opt/easel

USER 10001:10001
# 仅声明容器内端口；provisioner 不发布宿主端口。
EXPOSE 7860
CMD ["python", "-m", "easel.worker.lifecycle", "serve", \
     "--host", "0.0.0.0", "--port", "7860"]


# Chromium 是 worker 执行技能的必需依赖。浏览器与 Playwright 在本阶段
# 安装；启动阶段禁止联网安装。不得用 --no-sandbox 或额外 capabilities
# 换取“能启动”：沙箱不可用时真实浏览器门槛按未通过处理。
FROM base AS chromium

ARG PLAYWRIGHT_VERSION=1.49.1
# 默认使用 Debian 官方 CDN；受限网络可用 --build-arg APT_MIRROR=<base URL>
# 指定只读构建期镜像站，不改宿主/WSL 全局配置。
ARG APT_MIRROR=https://deb.debian.org
USER root
# Debian CDN 偶发 502；apt 自身重试，避免把网络瞬断误报成依赖不可用。
RUN printf 'Acquire::Retries "5";\n' > /etc/apt/apt.conf.d/80-retries
RUN if [ "${APT_MIRROR}" != "https://deb.debian.org" ]; then \
      for file in /etc/apt/sources.list /etc/apt/sources.list.d/*; do \
        if [ -f "$file" ]; then \
          sed -i -E "s|https?://deb\\.debian\\.org|${APT_MIRROR}|g" "$file"; \
        fi; \
      done; \
    fi
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates fonts-liberation fonts-noto-cjk \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
      libcups2 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 libnspr4 \
      libnss3 libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 \
      libxkbcommon0 libxrandr2 xdg-utils \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" \
 && PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
      playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* \
 && chmod -R a+rX,go-w /opt/playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
USER 10001:10001


# 执行阶段：worker 实际运行的 Web/ACP/技能代码与受管依赖。
# base 只负责生命周期入口，chromium 只负责浏览器；最终 runtime 在此基础上
# 固定管理员已验收的 Harness commit/profile。
FROM chromium AS execution

USER root
COPY deploy/multiuser/requirements-worker.txt /tmp/requirements-worker.txt
RUN pip install --no-cache-dir -r /tmp/requirements-worker.txt \
 && rm -f /tmp/requirements-worker.txt
COPY web ./web
COPY skills ./skills
# ACPAdapter.harness_instructions 强制要求公开共享工作区规则；
# 缺少 agents/workspace/AGENTS.md 会在发送 prompt 前失败。
COPY agents ./agents
COPY deploy/multiuser/smoke_worker.py ./deploy/multiuser/smoke_worker.py
COPY deploy/multiuser/smoke_harness.py ./deploy/multiuser/smoke_harness.py
COPY deploy/multiuser/verify_managed_profile.py ./deploy/multiuser/verify_managed_profile.py
COPY deploy/multiuser/worker_sidecar.py ./deploy/multiuser/worker_sidecar.py
COPY deploy/multiuser/egress_proxy.py ./deploy/multiuser/egress_proxy.py
COPY deploy/multiuser/db_tunnel.py ./deploy/multiuser/db_tunnel.py
RUN chown -R root:root /opt/easel \
 && chmod -R a-w /opt/easel
# 构建期实际校验文件、模块、worker 沙箱参数和假 Harness 子进程；
# 不以 base 的 lifecycle health 代替最终执行代码冒烟。
USER 10001:10001
RUN python deploy/multiuser/smoke_worker.py --check-files
CMD ["python", "-m", "easel.worker.server", "serve",      "--host", "0.0.0.0", "--port", "7860"]

# 最终阶段：固定源码构建的真实 DeepSeek Harness runtime 与受管 ACP profile。
# 构建阶段已完成 frozen 安装、Linux 原生组件和 Host/CLI 构建；这里只复制
# 已构建产物与固定 Node 运行时，运行阶段不再联网安装 npm/pnpm/pip。
FROM execution AS runtime

ARG DSH_COMMIT=""

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-client \
 && rm -rf /var/lib/apt/lists/*
COPY deploy/multiuser/managed /opt/easel/managed
RUN test -n "${DSH_COMMIT}" \
      || { echo "DSH_COMMIT 必须固定为已验收的 Harness commit" >&2; exit 1; } \
 && test -f /opt/easel/managed/acp-profile.json \
      || { echo "缺少经验证的 managed/acp-profile.json" >&2; exit 1; }

COPY --from=dsh-build /opt/dsh /opt/dsh
COPY --from=dsh-build /usr/local/bin/node /usr/local/bin/node
RUN chmod -R a-w /opt/dsh /opt/easel/managed

USER 10001:10001
# 真实 Harness 门槛：固定 checkout、CLI 构建产物、Node 引擎、原生 flock、
# profile/patch 只读性，以及真实 initialize/session/new。任何一项失败都
# 中止构建，不再用 .git/HEAD 或文件权限冒充 runtime 验收。
RUN DSH_COMMIT="${DSH_COMMIT}" \
      python deploy/multiuser/smoke_worker.py --check-files --require-dsh
